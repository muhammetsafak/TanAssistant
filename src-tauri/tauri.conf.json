{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tan",
  "identifier": "dev.muhammetsafak.tan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tan",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "category": "Productivity",
    "publisher": "Muhammet Safak",
    "shortDescription": "Meeting recorder that turns audio and screen frames into notes",
    "longDescription": "Tan records the audio of a meeting (microphone and system sound on separate channels) together with the screen frames that change, transcribes it with local whisper or an AI provider of your choice, and turns it into structured notes. All data stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libasound2t64 | libasound2",
          "libvulkan1",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "libxcb1",
          "libxrandr2",
          "libdbus-1-3"
        ],
        "recommends": [
          "xdg-desktop-portal",
          "pipewire-pulse | pulseaudio",
          "gnome-keyring | kwalletd5 | kwalletd6"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
